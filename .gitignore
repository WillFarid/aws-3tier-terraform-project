# Terraform working directories and provider binaries (large, regenerated by init)
**/.terraform/*

# State files: can contain sensitive values in plain text
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Variable files often hold secrets or environment-specific values.
# We commit only the *.tfvars.example files, never real values.
*.tfvars
*.tfvars.json
!*.tfvars.example

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Plan output files
*.tfplan

# CLI config (can hold credentials)
.terraformrc
terraform.rc

# Editor and OS noise
.vscode/
.DS_Store
# Windows folder metadata
desktop.ini
Thumbs.db
